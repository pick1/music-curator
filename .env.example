# Music Curator Environment Variables
# Copy this to .env and fill in your actual values

# AudD API (for audio fingerprinting)
AUDD_API_KEY=your_audd_api_key_here

# Spotify Web API
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIFY_REDIRECT_URI=http://localhost:8888/callback

# OpenRouter API (for genre classification)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=deepseek/deepseek-chat-v3-5  # optional, defaults to this